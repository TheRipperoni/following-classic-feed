# PostgreSQL connection string for the primary (write) database
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:password@db:5432/postgres

# PostgreSQL connection string for the read replica (optional, can be same as DATABASE_URL)
READ_REPLICA_URL=postgres://postgres:password@db:5432/postgres

# API key for authenticating internal service requests
API_KEY=your_api_key

# Port the HTTP server listens on (default: 8000)
PORT=8000

# HTTP Basic auth username for protected endpoints (e.g., stats)
USERNAME=your_username

# HTTP Basic auth password for protected endpoints
PASSWORD=your_password

# The public hostname where this feed generator is deployed
# Used in .well-known/did.json and describeFeedGenerator
FEEDGEN_HOSTNAME=your-feedgen.example.com

# The DID of this feed generator service (usually did:web:<hostname>)
FEEDGEN_SERVICE_DID=did:web:your-feedgen.example.com

# Rocket-specific settings
ROCKET_ADDRESS=0.0.0.0
ROCKET_ENV=prod

# JWT secret for HS256 token verification (only needed if HS256 is used)
# WARNING: HS256 is recommended for development/testing only; use ES256K in production
JWT_SECRET=your_jwt_secret
