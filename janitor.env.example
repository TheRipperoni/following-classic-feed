# PostgreSQL connection string for the database to clean
# Format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:password@db:5432/postgres

# Cron expression defining the cleanup schedule
# Format: standard cron expression (e.g., "0 0 0 * * *" for daily at midnight)
CRON_SCHEDULE="0 0 0 * * *"

# Number of days to retain posts, reposts, and likes before cleanup
RETENTION_DAYS=30
